  "recovery_policies": {
    "P0_HARD_CUTOVER": {
      "description": "revoke predecessor control acceptance at recovery start, then stage and commit the successor epoch",
      "predecessor_acceptance_at_recovery_start": false,
      "successor_acceptance_before_commit": false,
      "predecessor_revocation_event": "RECOVERY_START",
      "successor_acceptance_event": "NEW_EPOCH_COMMITTED",
      "trust_restored_requires": "POST_COMMIT_CONFIRMATION_COMPLETE"
    },
    "P1_STAGED_CUTOVER": {
      "description": "retain predecessor control acceptance while successor material is staged; atomically revoke predecessor and accept successor at commit",
      "predecessor_acceptance_at_recovery_start": true,
      "successor_acceptance_before_commit": false,
      "predecessor_revocation_event": "NEW_EPOCH_COMMITTED",
      "successor_acceptance_event": "NEW_EPOCH_COMMITTED",
      "trust_restored_requires": "POST_COMMIT_CONFIRMATION_COMPLETE"
    },
    "P2_HYBRID_OVERLAP": {
      "description": "retain predecessor acceptance and begin bounded successor acceptance after transition proof; revoke predecessor at commit",
      "predecessor_acceptance_at_recovery_start": true,
      "successor_acceptance_before_commit": "AFTER_TRANSITION_PROOF_ACCEPTED",
      "predecessor_revocation_event": "NEW_EPOCH_COMMITTED",
      "successor_acceptance_event": "TRANSITION_PROOF_ACCEPTED",
      "trust_restored_requires": "POST_COMMIT_CONFIRMATION_COMPLETE"
    },
    "P3_CONTACT_AWARE_STAGED": {
      "description": "use staged-cutover semantics with an additional deterministic pre-commit contact-budget guard",
      "predecessor_acceptance_at_recovery_start": true,
      "successor_acceptance_before_commit": false,
      "predecessor_revocation_event": "NEW_EPOCH_COMMITTED",
      "successor_acceptance_event": "NEW_EPOCH_COMMITTED",
      "commit_guard": "remaining_scheduled_contact_capacity_strictly_before_deadline_must_be_at_least_unsent_new_epoch_commit_signature_bytes_plus_unsent_post_commit_confirmation_signature_bytes",
      "guard_visible_inputs": [
