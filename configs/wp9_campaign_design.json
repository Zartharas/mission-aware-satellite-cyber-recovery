  "endpoint_model_rules": {
    "global": {
      "seed_role": "reproducible_block; use seed-aware mixed/clustered inference where applicable",
      "raw_counts_and_denominators_reported": true,
      "right_censoring_preserved": true,
      "no_missing_metric_imputation": true,
      "structural_degeneracy_rule": "If a pilot endpoint is constant, do not treat empirical zero variance or zero-width bootstrap intervals as definitive certainty. Use the predeclared exact/descriptive fallback and require WP9-C conservative sensitivity to pass.",
      "model_convergence_rule": "For nondegenerate simulated datasets, a planned primary model counts as converged only when estimation completes without singular fit, complete/quasi separation, invalid variance estimates, or nonfinite coefficients. Structural-degeneracy fallbacks are tracked separately and cannot manufacture a convergence pass."
    },
    "unauthorized_effect_completed": {
      "type": "binary",
      "primary_model": "binomial mixed model for factorial contrasts",
      "fallback": "cellwise exact binomial intervals and seed-blocked risk-difference bootstrap if separation/degeneracy"
    },
    "mission_objective_completion_ratio": {
      "type": "bounded_ratio",
      "primary_model": "linear mixed model on run-level frozen weighted ratio with seed block; bootstrap marginal contrasts",
      "fallback": "seed-blocked nonparametric contrasts"
    },
    "safety_invariant_violation_count": {
      "type": "count",
      "primary_model": "Poisson or negative-binomial mixed model selected by predeclared dispersion diagnostic",
      "fallback": "exact cellwise counts/upper bounds if structurally all zero"
    },
    "time_to_containment_s": {
      "type": "time_to_event",
      "primary_model": "restricted-mean-time contrast through frozen run horizon with seed-block bootstrap",
      "fallback": "Cox proportional-hazards sensitivity only when proportional-hazards diagnostics are acceptable"
    },
    "time_to_verified_recovery_s": {
      "type": "time_to_event_right_censored",
      "primary_model": "restricted-mean-time contrast through frozen run horizon with seed-block bootstrap",
      "fallback": "Cox proportional-hazards sensitivity only when proportional-hazards diagnostics are acceptable"
    },
    "recovery_terminal_state": {
      "type": "categorical",
      "primary_model": "multinomial model for P2/P3 when at least two estimable outcome categories occur",
      "fallback": "predeclared binary trusted-recovery-confirmed contrast plus full category counts"
    },
    "legitimate_command_rejection_rate": {
      "type": "binomial_ratio",
      "primary_model": "binomial mixed model from raw rejected/attempted counts rather than modeled ratio",
      "fallback": "exact intervals when denominator is sparse"
    },
    "ground_spacecraft_state_divergence_s": {
      "type": "continuous_nonnegative",
      "primary_model": "seed-blocked mixed model with bootstrap marginal contrasts",
      "fallback": "rank/quantile bootstrap sensitivity under strong skew"
    },
    "evidence_completeness_ratio": {
      "type": "bounded_ratio",
      "primary_model": "seed-blocked mixed/bootstrapped contrasts on run-level ratio",
      "fallback": "exact checklist numerator/denominator summaries when structurally discrete"
    },
    "effective_policy_id": {
      "type": "categorical_derived",
      "primary_model": "predeclared confusion/selection table and multinomial or binary generalized model where estimable",
      "source": "retained execution metadata; never ground-truth policy oracle"
    },
    "residual_unauthorized_state_count": {
      "type": "count_secondary_schema_field",
      "primary_model": "cellwise count comparison within P3",
      "fallback": "exact counts when sparse"
    }
  },
